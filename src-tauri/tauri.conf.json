{
  "productName": "CiupWifi",
  "version": "1.0.4",
  "identifier": "org.ciup.wifi",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CiupWifi",
        "width": 400,
        "height": 560,
        "resizable": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "CIUP WiFi Auto Login",
    "longDescription": "Automatic login and renewal for CIUP WifiCity network",
    "copyright": "Copyright © 2026 CiupWifi",
    "publisher": "CiupWifi Community",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
